{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aporto:agentfile",
  "title": "Aporto Agentfile (parsed TOML)",
  "description": "Standard TOML configuration after parsing to an object. Apply the documented semantic checks in addition to this structural schema.",
  "$comment": "Reject duplicate TOML keys during parsing. Apply format assertion when validating URI fields. Cross-file model.connection resolution, bundle/provider matching, source containment and symlink policy, target-path ownership, unique component names, exact MCP tool existence, runtime image/template validity, reserved or case-insensitive duplicate headers, and secret-reference binding are separate semantic checks. A string environment value is literal; only an object with secret is a secret reference.",
  "type": "object",
  "properties": {
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/dockerRuntime"
        },
        {
          "$ref": "#/$defs/agentenvRuntime"
        }
      ]
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/stdioMcp"
          },
          {
            "$ref": "#/$defs/httpMcp"
          }
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "required": [
    "agent",
    "model",
    "runtime"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "envName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "httpUri": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https?://",
      "description": "Absolute HTTP(S) URI. Semantic validation also rejects embedded credentials, query strings and fragments."
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.\\/-]+$"
    },
    "secret": {
      "type": "object",
      "properties": {
        "secret": {
          "$ref": "#/$defs/secretName"
        }
      },
      "required": [
        "secret"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "connection": {
          "$ref": "#/$defs/identifier"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "effort"
          ],
          "additionalProperties": false
        },
        "text": {
          "type": "object",
          "properties": {
            "verbosity": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "verbosity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "connection"
      ],
      "additionalProperties": false
    },
    "dockerRuntime": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "docker"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^-\\s][^\\s]*$"
        },
        "images": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^-\\s][^\\s]*$"
          },
          "description": "Additional allowed references. The default is always included; at most 16 unique choices including the default. Listing the default once is permitted and normalized away."
        },
        "workdir": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/",
          "default": "/workspace",
          "description": "Absolute container-local non-root directory, never a host path. Reject dot/dotdot, repeated separators, backslash, control characters and reserved runtime-resource paths. One trailing slash is normalized away."
        }
      },
      "required": [
        "provider",
        "image"
      ],
      "additionalProperties": false
    },
    "agentenvRuntime": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "agentenv"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "templates": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "Additional allowed references. The default is always included; at most 16 unique choices including the default. Listing the default once is permitted and normalized away."
        },
        "workdir": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/",
          "default": "/workspace",
          "description": "Absolute container-local non-root directory, never a host path. Reject dot/dotdot, repeated separators, backslash, control characters and reserved runtime-resource paths. One trailing slash is normalized away."
        }
      },
      "required": [
        "provider",
        "template"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "system",
            "developer"
          ],
          "default": "developer"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    },
    "stdioMcp": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/argv"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/envName"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/secret"
              }
            ]
          }
        },
        "include_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolName"
          },
          "description": "Optional exact-name restriction within this declared MCP server; omission permits its discovered tools. Wildcards are not allowed."
        }
      },
      "required": [
        "name",
        "command"
      ],
      "additionalProperties": false
    },
    "httpMcp": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "$ref": "#/$defs/httpUri"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/secret"
          }
        },
        "include_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolName"
          },
          "description": "Optional exact-name restriction within this declared MCP server; omission permits its discovered tools. Wildcards are not allowed."
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "max_model_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "max_parallel_tools": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "additionalProperties": false
        },
        "ptc": {
          "type": "object",
          "properties": {
            "cell_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 8,
              "maximum": 1024
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 256,
              "maximum": 16777216
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
